<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1C"
    tools:context=".AppView">

    <TextView
        android:id="@+id/demoEyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="32dp"
        android:layout_marginTop="22dp"
        android:letterSpacing="0.14"
        android:text="@string/demo_catalogue_eyebrow"
        android:textAllCaps="true"
        android:textColor="#6EA8FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/demoTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/demoEyebrow"
        android:layout_alignParentStart="true"
        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp"
        android:text="@string/demo_catalogue_title"
        android:textColor="#FFFFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/appListText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/demoTitle"
        android:layout_alignParentStart="true"
        android:layout_marginStart="32dp"
        android:layout_marginTop="2dp"
        android:gravity="start"
        android:paddingBottom="14dp"
        android:preferKeepClear="true"
        android:text="@string/demo_catalogue_tagline"
        android:textColor="#AFC0D9"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/demoControllerCta"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_alignParentEnd="true"
        android:layout_alignTop="@id/demoTitle"
        android:layout_marginEnd="32dp"
        android:background="@drawable/demo_controller_cta_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="190dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/demo_phone_controller"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/demoHero"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_below="@id/appListText"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/demo_hero_background"
        android:paddingStart="20dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/demoHeroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@id/demoHeroAction"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/demo_hero_title_default"
            android:textColor="#FFFFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/demoHeroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/demoHeroTitle"
            android:layout_alignParentStart="true"
            android:layout_marginTop="5dp"
            android:layout_toStartOf="@id/demoHeroAction"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/demo_hero_meta_default"
            android:textColor="#AFC0D9"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/demoHeroAction"
            android:layout_width="112dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/demo_controller_cta_background"
            android:gravity="center"
            android:text="@string/demo_hero_action_play"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center">

        <com.google.android.gms.ads.AdView
            android:id="@+id/demoBannerAd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            ads:adSize="BANNER"
            ads:adUnitId="@string/demo_admob_banner_id" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/adContainer"
        android:layout_below="@id/demoHero"
        android:gravity="center" />

</RelativeLayout>
