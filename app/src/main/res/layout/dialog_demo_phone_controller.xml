<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/demoGameControllerHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/demo_game_controller_dialog_help"
        android:textSize="15sp"
        android:paddingBottom="14dp" />

    <FrameLayout
        android:layout_width="276dp"
        android:layout_height="276dp"
        android:background="@drawable/demo_qr_frame"
        android:padding="14dp">

        <ImageView
            android:id="@+id/demoGameControllerQr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/demo_controller_title"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/demoGameControllerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="#AFC0D9"
        android:textSize="12sp" />

</LinearLayout>
