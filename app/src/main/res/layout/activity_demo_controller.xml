<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1C"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="36dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="38dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_controller_title"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/demo_controller_subtitle"
            android:textColor="#AFC0D9"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/demoControllerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="#6EA8FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/demoControllerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textColor="#7F8DA4"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:background="@drawable/demo_qr_frame"
        android:padding="18dp">

        <ImageView
            android:id="@+id/demoControllerQr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/demo_controller_title"
            android:scaleType="fitCenter" />
    </FrameLayout>

</LinearLayout>
